# Copy to .env and adjust. Everything here is public — it ships in the browser bundle.

# Base URL of the Classmate Node API, including the /api prefix.
#   leave empty  → requests go to /api and Vite proxies them to API_PROXY_TARGET (dev default)
#   production   → https://api.your-domain.com/api
VITE_API_URL=

# Canonical site origin, used for SEO tags, sitemap links and share cards.
VITE_SITE_URL=https://classmate.co.tz

# Dev only: where the /api proxy forwards to. Point at the VPS to develop on live data.
API_PROXY_TARGET=http://localhost:5000
