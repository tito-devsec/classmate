# Copy to server/.env and fill in. Never commit the real file.

NODE_ENV=development

# The Postman collection's base_url is http://localhost:5000/api
PORT=5000
API_PREFIX=/api

# Browser origins allowed to call this API (comma separated).
# On the VPS set this to the deployed web origin, e.g. https://classmate.co.tz
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Seed administrator for POST /api/admin/login (development mock only).
ADMIN_EMAIL=admin@classmate.tz
ADMIN_PASSWORD=ChangeMe123!@

# Optional: any OpenAI-compatible chat-completions provider powers the school advisor.
# Leave AI_API_KEY empty to run without the assistant — the API answers 503 and the UI
# falls back to the enquiry form.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Override only if the dataset or writable state live outside the repo.
# DATA_DIR=/srv/classmate/data
# STATE_DIR=/var/lib/classmate
